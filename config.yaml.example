# ============ 服务器 IP 配置（只改这一处）============
server:
  ip: localhost

# ====================================================

app:
  host: 0.0.0.0
  port: 8080

kafka:
  bootstrap-servers: ${server.ip}:9092
  consumer:
    group-id: rag-system
  topics:
    document-raw: document-raw
    document-chunked: document-chunked
    document-indexed: document-indexed

milvus:
  uri: http://${server.ip}:19530
  collection: rag_chunks

elasticsearch:
  host: ${server.ip}
  port: 9201
  index: rag_documents

mysql:
  host: ${server.ip}
  port: 3307
  database: rag_system
  username: root
  password: YOUR_PASSWORD_HERE

llm:
  provider: minimax
  api-key: YOUR_MINIMAX_API_KEY_HERE
  model: MiniMax-Text-01
  base-url: https://api.minimax.chat/v1
  group-id: YOUR_MINIMAX_GROUP_ID_HERE

embedding:
  model: BAAI/bge-m3
  dimension: 1024
  base-url: https://api.siliconflow.cn/v1
  api-key: YOUR_SILICONFLOW_API_KEY_HERE

reranker:
  model: BAAI/bge-reranker-v2-m3

memory:
  window-size: 10
  summary-threshold: 8
  ttl-days: 7

chunking:
  chunk-size: 512
  chunk-overlap: 50

minio:
  endpoint: http://${server.ip}:9001
  access-key: minioadmin
  secret-key: minioadmin
  bucket: rag-documents

# ====================================================
# 文档增强提取配置（图片 OCR + 表格解析）
# ====================================================
extraction:
  enabled: false
  
  image:
    enabled: true
    min-size: 50
    ocr:
      provider: aliyun
      api-key: YOUR_ALIYUN_OCR_API_KEY_HERE
      api-secret: YOUR_ALIYUN_OCR_API_SECRET_HERE
      region: cn-shanghai
      language: ZH-CN
  
  table:
    enabled: true
    parser:
      provider: aliyun
      api-key: YOUR_ALIYUN_TABLE_API_KEY_HERE
      api-secret: YOUR_ALIYUN_TABLE_API_SECRET_HERE
      region: cn-shanghai
      output-format: html
  
  processing:
    parallel: true
    max-concurrency: 4
    timeout-seconds: 30
    retry-count: 2

# ====================================================
# ReAct 执行引擎配置
# ====================================================
react:
  enabled: false

  # 复杂度路由配置
  router:
    enabled: true
    model: Qwen2-1.5B
    timeout-ms: 100

  # Action Space 配置
  actions:
    knowledge:
      enabled: true
      top-k: 5
    database:
      enabled: true
    conversation:
      enabled: true
      window-size: 10

  # 缓存配置
  cache:
    enabled: true
    similarity-threshold:
      direct-hit: 0.95
      review: 0.85

  # 死循环检测配置
  loop-detection:
    enabled: true
    max-iterations: 5
    fingerprint-match-count: 3

  # 轻量级 LLM 配置（用于复杂度路由和事实提炼）
  lightweight-llm:
    model: Qwen2-1.5B
    provider: local
    base-url: http://localhost:8081/v1
    api-key: dummy
    timeout-ms: 10000

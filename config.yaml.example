# ============ 服务器 IP 配置（只改这一处）============
server:
  ip: localhost

# ====================================================

app:
  host: 0.0.0.0
  port: 8080

kafka:
  bootstrap-servers: ${server.ip}:29292
  consumer:
    group-id: rag-system
  topics:
    document-raw: document-raw
    document-chunked: document-chunked
    document-indexed: document-indexed

milvus:
  uri: http://${server.ip}:29530
  collection: rag_chunks

elasticsearch:
  host: localhost
  port: 29201
  index: rag_documents

# Redis (用于会话 Memory 缓存)
redis:
  host: localhost
  port: 26379
  database: 0
  ttl-days: 7

mysql:
  host: ${server.ip}
  port: 23306
  database: rag_system
  username: root
  password: YOUR_PASSWORD_HERE

llm:
  provider: minimax
  api-key: YOUR_MINIMAX_API_KEY_HERE
  model: MiniMax-Text-01
  base-url: https://api.minimax.chat/v1
  group-id: YOUR_MINIMAX_GROUP_ID_HERE

embedding:
  model: BAAI/bge-m3
  dimension: 1024
  base-url: https://api.siliconflow.cn/v1
  api-key: YOUR_SILICONFLOW_API_KEY_HERE

reranker:
  model: BAAI/bge-reranker-v2-m3
  base-url: https://api.siliconflow.cn/v1
  api-key: YOUR_SILICONFLOW_API_KEY_HERE
  enabled: true

memory:
  window-size: 10
  summary-threshold: 8
  ttl-days: 7

chunking:
  chunk-size: 512
  chunk-overlap: 50

minio:
  endpoint: http://${server.ip}:29005
  access-key: minioadmin
  secret-key: minioadmin
  bucket: rag-documents

# ====================================================
# 文档增强提取配置（图片 OCR + 表格解析）
# ====================================================
extraction:
  enabled: false

  image:
    enabled: true
    min-size: 50
    ocr:
      provider: aliyun
      api-key: YOUR_ALIYUN_OCR_API_KEY_HERE
      api-secret: YOUR_ALIYUN_OCR_API_SECRET_HERE
      region: cn-shanghai
      language: ZH-CN

  table:
    enabled: true
    parser:
      provider: aliyun
      api-key: YOUR_ALIYUN_TABLE_API_KEY_HERE
      api-secret: YOUR_ALIYUN_TABLE_API_SECRET_HERE
      region: cn-shanghai
      output-format: html

  processing:
    parallel: true
    max-concurrency: 4
    timeout-seconds: 30
    retry-count: 2

# ====================================================
# ReAct 执行引擎配置（2026-09-24 与 AppConfig 默认值对齐）
# ====================================================
react:
  enabled: false                 # 引擎总开关（开启前确认 security 已收紧——QUERY_DATABASE 会执行 SQL）

  # 复杂度路由：LLM 判定 SIMPLE/COMPLEX，失败/超时一律 SIMPLE
  router:
    enabled: true
    model: deepseek-chat         # 任意 OpenAI 兼容模型
    timeout-ms: 5000

  # Action Space 配置
  actions:
    knowledge:
      enabled: true
      top-k: 5
    database:
      enabled: true
      read-only: true            # 只读护栏：仅放行单条 SELECT/WITH，拒绝多语句/注释/INTO OUTFILE
      allowed-tables: []         # 表白名单（空=不限；生产建议白名单，排除 t_user 等敏感表）
      max-rows: 100              # 查询行数上限（驱动层 setMaxRows）
    conversation:
      enabled: true
      window-size: 10

  # 缓存配置（TTL 与容量上限为 2026-09-24 新增）
  cache:
    enabled: true
    ttl-ms: 3600000              # 条目 TTL（0=不过期）
    max-entries: 500             # 容量上限（超限按写入时间淘汰）
    similarity-threshold:
      direct-hit: 0.95           # 嵌入余弦 ≥ 此值直接复用缓存结果
      review: 0.85               # 复核区下限（当前为未接线的设计保留）

  # 死循环检测配置
  loop-detection:
    enabled: true
    max-iterations: 5
    fingerprint-match-count: 3

  # 轻量级 LLM（事实提炼用；provider=local 时走本地端点，否则用 api-key 远程）
  lightweight-llm:
    model: glm-5.3-flash
    provider: zhipu
    base-url: https://open.bigmodel.cn/api/paas/v4
    api-key: YOUR_ZHIPU_API_KEY_HERE
    timeout-ms: 10000

# ============ 服务器 IP 配置（只改这一处）============
server:
  ip: localhost

# ====================================================

app:
  host: 0.0.0.0
  port: 8080

kafka:
  bootstrap-servers: ${server.ip}:9092
  consumer:
    group-id: rag-system
  topics:
    document-raw: document-raw
    document-chunked: document-chunked
    document-indexed: document-indexed

milvus:
  uri: http://${server.ip}:19530
  collection: rag_chunks

elasticsearch:
  host: ${server.ip}
  port: 9201
  index: rag_documents

mysql:
  host: ${server.ip}
  port: 3307
  database: rag_system
  username: root
  password: YOUR_PASSWORD_HERE

llm:
  provider: minimax
  api-key: YOUR_MINIMAX_API_KEY_HERE
  model: MiniMax-Text-01
  base-url: https://api.minimax.chat/v1
  group-id: YOUR_MINIMAX_GROUP_ID_HERE

embedding:
  model: BAAI/bge-m3
  dimension: 1024
  base-url: https://api.siliconflow.cn/v1
  api-key: YOUR_SILICONFLOW_API_KEY_HERE

reranker:
  model: BAAI/bge-reranker-v2-m3

memory:
  window-size: 10
  summary-threshold: 8
  ttl-days: 7

chunking:
  chunk-size: 512
  chunk-overlap: 50

minio:
  endpoint: http://${server.ip}:9001
  access-key: minioadmin
  secret-key: minioadmin
  bucket: rag-documents
